# ==============================================================================
# PokeSell Ops (pokesell-multi-agent) — Environment Configuration Template
# Copy to `.env` for local overrides. NEVER commit real API keys or secrets.
# Production secrets are retrieved dynamically via Google Cloud Secret Manager.
# ==============================================================================

# Google Cloud / Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
AGENT_ENGINE_ID=

# Strategic Model Routing Tiers
FAST_STREAM_MODEL=gemini-2.5-flash
PRO_REASONING_MODEL=gemini-2.5-pro

# Local SQLite Relational + Vector Store Path
POKESELL_DB_PATH=data/pokesell_ledger.db

# Observability & Privacy Controls
ENABLE_CLOUD_DLP=false
ENABLE_CLOUD_TRACE_EXPORT=false
ENABLE_CLOUD_LOGGING=false
ENABLE_GCP_SECRET_MANAGER=true

# Secure Local Command Center Web BFF Settings
POKESELL_BIND_HOST=127.0.0.1
POKESELL_BIND_PORT=8080
POKESELL_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
